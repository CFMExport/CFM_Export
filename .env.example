# Copy to .env and adjust.

# Require HTTP basic auth (any username) on /admin. Recommended.
ADMIN_PASSWORD=change-me

# Auto-export the current week for every configured league on this interval.
# Leave unset to trigger exports manually from /admin (or via Synology Task
# Scheduler: curl -X POST http://localhost:5000/admin/league/<id>/export)
#AUTO_EXPORT_MINUTES=60
# Also export full rosters on the schedule (slow: ~33 EA calls per league)
#AUTO_EXPORT_ROSTERS=true

# --- EA constants -----------------------------------------------------------
# Defaults target Madden 27 (current). They come from the snallabot project:
# https://github.com/snallabot/snallabot-service/blob/main/src/dashboard/ea_constants.ts
# When a new Madden releases (or EA rotates credentials), update from there.

# For a league still on Madden 26:
#EA_BLAZE_YEAR=2026
#EA_COMPONENT_NAME=careermode

#EA_CLIENT_ID=MCA_26_COMP_APP
#EA_CLIENT_SECRET=...
#EA_AUTH_SOURCE=317239
#EA_MACHINE_KEY=444d362e8e067fe2
#EA_ENTITLEMENT_YEAR=26
